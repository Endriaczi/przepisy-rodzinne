rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isAllowedFamilyMember() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/allowedUsers/$(request.auth.token.email));
    }

    function isAdministrator() {
      return isAllowedFamilyMember() &&
        firestore.get(/databases/(default)/documents/allowedUsers/$(request.auth.token.email)).data.role == 'admin';
    }

    // Family portraits can be read by approved accounts only.
    match /portraits/{portraitFile} {
      allow read: if isAllowedFamilyMember();
      allow create, update: if isAdministrator()
        && portraitFile in ['emilka.jpg', 'kasia.jpg']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Other private assets are not open for client uploads yet.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
