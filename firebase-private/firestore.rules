rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isAllowedFamilyMember() {
      return signedIn() &&
        exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
    }

    function isAdministrator() {
      return isAllowedFamilyMember() &&
        get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.role == 'admin';
    }

    function canReviewRecipes() {
      return isAllowedFamilyMember() &&
        get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email)).data.role in ['admin', 'reviewer'];
    }

    match /allowedUsers/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /recipes/{recipeId} {
      allow read: if canReviewRecipes() ||
        (isAllowedFamilyMember() && resource.data.familyReady == true);
      allow create: if isAdministrator();
      allow update: if canReviewRecipes();
      allow delete: if isAdministrator();
    }

    match /histamineProducts/{productId} {
      allow read: if isAllowedFamilyMember();
      allow create, update, delete: if isAdministrator();
    }

    match /recipeReviews/{recipeId} {
      allow read: if canReviewRecipes();
      allow create, update: if canReviewRecipes();
      allow delete: if isAdministrator();
    }

    match /ingredientRules/{ruleId} {
      allow read: if isAllowedFamilyMember();
      allow create, update: if canReviewRecipes();
      allow delete: if isAdministrator();
    }

    match /userFavorites/{userId}/recipes/{recipeId} {
      allow read, create, update, delete: if isAllowedFamilyMember() && request.auth.uid == userId;
    }

    match /emilkaMealLog/{entryId} {
      allow create: if isAdministrator() || (isAllowedFamilyMember() &&
        request.resource.data.createdByUid == request.auth.uid);
      allow read: if canReviewRecipes() ||
        (isAllowedFamilyMember() && resource.data.createdByUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isAllowedFamilyMember();
      allow write: if false;
    }
  }
}
